# Copy to .env and fill in. Every key is optional: the value shown is the default in vcgraph/config.py.

# ---- storage
MONGO_URI=mongodb://localhost:27017
# with docker-compose.prod.yml (auth on): mongodb://<MONGO_ROOT_USER>:<MONGO_ROOT_PASSWORD>@localhost:27017/?authSource=admin
MONGO_DB=vcgraph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# only read by docker-compose.prod.yml (Mongo root user, created on first start of an empty volume)
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# ---- models (Ollama)
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=llama3.1:8b
EXTRACT_MODEL=qwen2.5:14b
# DO NOT CHANGE on a restored graph: node embeddings in Neo4j were computed with this model.
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
# "ollama" (real) or "hash" (offline tests only)
EMBED_BACKEND=ollama

# ---- OpenAI (only needed for eval: GPT-4o judge / RAGAS)
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o

# ---- crawling (only needed to collect new data)
SEC_USER_AGENT=VCGraph Research contact@example.com
OPENCORPORATES_API_TOKEN=

# ---- random walk (the reported point/explore runs used WALK_TOP_NODES=12)
WALK_NUM_WALKERS=32
WALK_MAX_ITERS=12
WALK_RESTART_P=0.15
WALK_TEMPERATURE=0.25
WALK_GAIN_EPS=0.05
WALK_PATIENCE=2
WALK_TOP_NODES=20
# token budget of the k-hop "expand" baseline
EXPAND_MAX_TOKENS=16000
